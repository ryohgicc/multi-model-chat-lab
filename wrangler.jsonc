{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multi-model-chat-lab",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SHARED_CONFIG", "id": "2896d2bc8d2645deb65a7650f62e6a33" }
  ]
}
